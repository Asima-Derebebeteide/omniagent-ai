NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/omniagent
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CORS_ORIGIN=http://127.0.0.1:3000
ALLOW_REGISTRATION=true

# Meta webhook verification token (choose your own random string)
META_VERIFY_TOKEN=replace_me
# Telegram webhook secret token (optional)
TELEGRAM_WEBHOOK_SECRET=
# Public API URL used when setting webhook URLs
PUBLIC_API_URL=https://your-public-domain.example

# Optional Meta Graph API version override
META_GRAPH_API_VERSION=v23.0
